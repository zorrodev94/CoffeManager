<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>CoffeManager-Local-Development-2026</UserSecretsId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\User\Contracts\" />
    <Folder Include="Models\User\Services\" />
    <Folder Include="Models\User\Subclases\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CoffeManager.Client.Admin/**/*.cs" />
    <Compile Remove="Tests/**/*.cs" />
    <Content Remove="Tests/**" />
    <Content Remove="App_Data/**" />
    <None Remove="App_Data/**" />
    <None Remove="Tests/**" />
    <Content Remove="CoffeManager.Client.Admin/**" />
    <EmbeddedResource Remove="CoffeManager.Client.Admin/**" />
    <None Remove="CoffeManager.Client.Admin/**" />
  </ItemGroup>
<ItemGroup><Content Include="Infrastructure/Database/Scripts/*.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
